# Copie para .env na VPS (nunca commitar o .env). Usado pelo docker-compose.prod.yml.
# openssl rand -hex 24
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Mínimo de 32 caracteres (openssl rand -base64 48). Trocar invalida as sessões abertas
JWT_SECRET=troque-por-um-segredo-longo
# Domínio público do app (sem https://). Vazio desativa o redirecionamento de host
CANONICAL_HOST=
