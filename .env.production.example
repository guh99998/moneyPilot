# Copie para .env na VPS (nunca commitar o .env). Usado pelo docker-compose.prod.yml.
# openssl rand -hex 24
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Mínimo de 32 caracteres (openssl rand -base64 48). Trocar invalida as sessões abertas
JWT_SECRET=troque-por-um-segredo-longo
# Domínio público do app (sem https://). Vazio desativa o redirecionamento de host
CANONICAL_HOST=
# URL pública do app, com https:// e sem barra final (base dos links nos e-mails)
PUBLIC_URL=https://app.exemplo.com
# Client ID OAuth (Web) do Google para "Entrar com Google" (não é segredo). Vazio desliga o recurso
GOOGLE_CLIENT_ID=
# E-mail transacional via Resend: remetente de um domínio verificado no Resend e chave de API
MAIL_FROM_ADDRESS=nao-responda@exemplo.com
RESEND_API_KEY=re_troque-pela-chave
# Endereço que recebe os chamados de "Falar com o suporte" (sem ele o app não sobe)
SUPPORT_EMAIL=suporte@exemplo.com
# Contas administradoras do painel de chamados, e-mails separados por vírgula (opcional)
ADMIN_EMAILS=
# Apoio ao projeto: chave Pix ALEATORIA (nunca CPF, telefone ou e-mail pessoal) e caminho da imagem do QR code dentro do container (opcionais)
PIX_KEY=
PIX_QR_FILE=
# Pasta do servidor com a imagem do QR code, montada como /pix no container (default /opt/moneypilot-pix). Ex.: PIX_QR_FILE=/pix/qr.png
PIX_QR_DIR=
